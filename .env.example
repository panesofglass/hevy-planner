# Personal deployment values — copy this file to `.env.local` and fill in
# your own values. `.env.local` is gitignored (see .gitignore); NEVER commit
# real names, emails, or personal URLs.

# Auto-deploy endpoint for the Workers dev environment (see AGENTS.md → Deployment)
DEV_WORKER_URL=https://your-subdomain.workers.dev

# Optional: override the program schema $id at validator build time
# (npm run build:schema reads SCHEMA_PROGRAM_ID from the environment).
# Leave unset to keep the neutral committed $id.
SCHEMA_PROGRAM_ID=

# Git authorship for CI/automation agents — kept out of committed files
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com